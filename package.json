{
  "name": "@wwskills/dsh-web-search-providers",
  "version": "0.4.0",
  "description": "Web search providers for DSH: Tavily + Baidu + extensible",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "prepack": "node build.mjs",
    "prepare": "node build.mjs"
  },
  "keywords": ["dsh", "deepseek-harness", "web-search", "tavily", "baidu", "cordis"],
  "license": "MIT",
  "author": "wwskills",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/schemastery": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-web": ">=0.1.0-rc.6 <0.2.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wwskills/dsh-web-search-providers.git"
  },
  "bugs": {
    "url": "https://github.com/wwskills/dsh-web-search-providers/issues"
  },
  "homepage": "https://github.com/wwskills/dsh-web-search-providers#readme",
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
