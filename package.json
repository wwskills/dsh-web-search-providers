{
  "name": "@wwskills/dsh-web-search-providers",
  "version": "0.4.0",
  "description": "Web search providers for DSH: Tavily + Baidu + extensible",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": ["dsh", "deepseek-harness", "web-search", "tavily", "baidu", "cordis"],
  "license": "MIT",
  "author": "wwskills",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-web": "0.2.1-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wwskills/dsh-web-search-providers.git"
  },
  "bugs": {
    "url": "https://github.com/wwskills/dsh-web-search-providers/issues"
  },
  "homepage": "https://github.com/wwskills/dsh-web-search-providers#readme",
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
